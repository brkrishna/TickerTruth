{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -c ' *)",
      "Bash(.venv/bin/pytest pipelines/phase2_validator.py::TestTask7SymbolLinker::test_cross_reference_boosts_confidence_on_match -v --tb=long)"
    ],
    "ask": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(npm install*)",
      "Bash(npx wrangler deploy*)",
      "Bash(npx wrangler secret*)",
      "Bash(wrangler deploy*)",
      "Bash(wrangler secret*)",
      "Edit(CLAUDE.md)",
      "Edit(.claude/**)",
      "Edit(wrangler.jsonc)",
      "Edit(package.json)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(.dev.vars)",
      "Read(**/.dev.vars)",
      "Read(**/*secret*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/lint-and-sanity.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/test-on-edit.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
